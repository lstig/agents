{
  "name": "lstig-agents",
  "owner": {
    "name": "Luke Stigdon"
  },
  "description": "Portable customizations for AI coding agents.",
  "plugins": [
    {
      "name": "development",
      "source": "./",
      "description": "General development skills: open PRs/MRs on any forge, ship finished worktrees.",
      "version": "0.1.0",
      "license": "MIT",
      "repository": "https://github.com/lstig/agents",
      "strict": false,
      "skills": [
        "./skills/experimental/pr",
        "./skills/experimental/shipit"
      ]
    },
    {
      "name": "workflow",
      "source": "./",
      "description": "Joplin-backed task workflow: durable task notes plus a skill that drives work from them.",
      "version": "0.3.1",
      "license": "MIT",
      "repository": "https://github.com/lstig/agents",
      "strict": false,
      "skills": [
        "./skills/experimental/task-notes",
        "./skills/experimental/task-work"
      ],
      "mcpServers": "./.claude-plugin/mcp.json"
    },
    {
      "name": "sdlc",
      "source": "./",
      "description": "Chained SDLC artifacts: intent, spec, and plan as reviewed markdown, with stage gates enforced by hooks.",
      "version": "0.1.1",
      "license": "MIT",
      "repository": "https://github.com/lstig/agents",
      "strict": false,
      "skills": [
        "./skills/experimental/intent",
        "./skills/experimental/spec",
        "./skills/experimental/plan"
      ],
      "hooks": {
        "PreToolUse": [
          {
            "matcher": "Write|Edit",
            "hooks": [
              {
                "type": "command",
                "command": "${CLAUDE_PLUGIN_ROOT}/.claude-plugin/hooks/sdlc-gate.sh"
              }
            ]
          }
        ]
      }
    }
  ]
}
